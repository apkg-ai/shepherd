[0.000, "o", "Gembeddable\r\u001b[2C\u001b[1Bwithout\u001b[11GHTTP)\u001b[17Gbreaks.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo\u001b[6Gto\u001b[9Ganswer\u001b[16Gdirectly:\u001b[26G\u001b[1mno, it's not fully automatic\u001b[22m.\u001b[56GThe\u001b[60Gspec-to-wire-types\u001b[79Gpart\u001b[84Gis\u001b[87Gautomatic.\u001b[98GThe\u001b[102Gwire-to-domain\u001b[117Gbridging\u001b[126Gis\u001b[129Gmanual.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 28s · done 10:54 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m❯ \u001b[38;2;255;255;255mdo we have some good coverage and all features are tested?\u001b[39m                                                                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mLet\u001b[7Gme\u001b[10Gaudit\u001b[16Gthis\u001b[21Gproperly\u001b[30G—\u001b[32Gmap\u001b[36Gevery\u001b[42Gdeliverable\u001b[54Gto\u001b[57Gits\u001b[61Gtests\u001b[67Gand\u001b[71Gfind\u001b[76Ggaps.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Reading \u001b[1m1\u001b[22m file, running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cargo test -p shepherd-core 2>&1 | grep \"^test \" | wc -l && cargo test -p shepherd-core 2>&1 | grep \""]
