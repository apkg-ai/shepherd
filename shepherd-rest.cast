[0.000, "o", "────────────────────────────────┘\r\u001b[5C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B\u001b[1mVerification\r\u001b[5C\u001b[1B\u001b[22m\u001b[K\r\u001b[5C\u001b[1B1\u001b[9G\u001b[38;2;177;185;249mopenapi-to-rust gen\u001b[30Gate --check\u001b[39m — ge\u001b[47Gerated \u001b[55Gutput is fresh\u001b[K\r\u001b[5C\u001b[1B2\u001b[32G\u001b[38;2;177;185;249mse\u001b[35Gver\u001b[39G\u001b[39m— all integr\u001b[52Gtion + con\u001b[63Gract te\u001b[71Gts\u001b[74Gpass\r\u001b[5C\u001b[1B3\u001b[15G\u001b[38;2;177;185;249mtest -p shepherd-core\u001b[39m —\u001b[39Gexisting\u001b[48Gdomain\u001b[55Gtests\u001b[61Gstill\u001b[67Gpass\r\u001b[5C\u001b[1B4\u001b[15G\u001b[38;2;177;185;249mclippy -D warnings\u001b[39m — no\u001b[39Gwarnings\r\u001b[5C\u001b[1B5\u001b[9G\u001b[38;2;177;185;249mcargo fmt --check\u001b[39m — formatted\u001b[K\r\u001b[5C\u001b[1B6.\u001b[9G\u001b[38;2;177;185;249mspectral lint openapi/shepherd.yaml\u001b[45G\u001b[39m—\u001b[47G0\u001b[49Gerrors\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mPlan\u001b[8Gapproved.\u001b[18GLet\u001b[22Gme\u001b[25Gstart\u001b[31Gby\u001b[34Ginstalling\u001b[45Gopenapi-to-rust\u001b[61Gand\u001b[65Ggenerating\u001b[76Gthe\u001b[80Gcode.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[39m Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ "]
