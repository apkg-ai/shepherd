[0.000, "o", "but\u001b[17Gno in\u001b[24Ggration test\u001b[37Gve\u001b[40Gifies the\u001b[50Gwire format \u001b[63Gursor works\u001b[75Gend-to-end.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUpdate project settings\u001b[22m —\u001b[32G\u001b[38;2;177;185;249mproject_crud_lifecycle\u001b[55G\u001b[39mupdates the name but \u001b[77Gever tests\u001b[88Gchanging\u001b[97G\u001b[38;2;177;185;249mreview_gate\u001b[109G\u001b[39mvia\u001b[113GPATCH.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mTask metadata\u001b[22m — no test\u001b[30Gcreates a task with metadata and\u001b[63Gverifies\u001b[72Git round-trips.\u001b[88G\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mRequest validation\u001b[25G\u001b[22m— the g\u001b[33Gnerated code valida\u001b[53Ges request bodies,\u001b[72Gbut no test verifies\u001b[93Gthat\u001b[98Gan\u001b[101Ginvalid\u001b[109Grequest\u001b[117Gbody\u001b[122G(e.g.,\u001b[129Gmissing\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;177;185;249mtitle\u001b[39m on task create) r\u001b[30Gtur\u001b[34Gs \u001b[37G proper 422. The \u001b[38;2;177;185;249minvalid_uuid_returns_error\u001b[39m test cover\u001b[93Gpath\u001b[98Gparam validation, but not body\u001b[129G\u001b[K\r\u001b[5C\u001b[1Bvalidation.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGaps\u001b[8G#1\u001b[11Gand\u001b[15G#2\u001b[18Gare\u001b[22Gblocked\u001b[30Gby\u001b[33GS5\u001b[36G(claims/sessions\u001b[53Garen't\u001b[60Gwired\u001b[66Gyet).\u001b[72G"]
