[0.064, "o", "\u001b[?2026h\u001b[H\r\u001b[2C\u001b[1B\u001b[1mKeep hand-wri\u001b[17Gte\u001b[20G types + contract tests for now.\u001b[53G\u001b[22mHere's\u001b[60Gwhy:\r\u001b[2C\u001b[2B1. The API surface in S4 is 19 endpoints with ~6 respon\u001b[59Ge shapes.\u001b[69GThat's\u001b[76Gsmall\u001b[82Genough\u001b[89Gthat\u001b[94Ghand-written\u001b[107Gtypes\u001b[113G+\u001b[115Gcontract\u001b[124Gtests\u001b[130Gare\r\u001b[5C\u001b[1Bpractical\u001b[16Gand\u001b[20Gthe\u001b[24Gindirection\u001b[36Gof\u001b[39Ga\u001b[41Gcodegen\u001b[49Gstep\u001b[54Gdoesn't\u001b[62Gpay\u001b[66Gfor\u001b[70Gitself\u001b[77Gyet.\r\u001b[2C\u001b[1B2\u001b[6GBoth viable generators are pre-1.0 — a minor ver\u001b[55Gi\u001b[58G bump can change the gen\u001b[83Grated\u001b[89GAPI.\u001b[94GThat's a main\u001b[108Genance\u001b[115Grisk for\u001b[124Ga project\r\u001b[5C\u001b[1Bth\u001b[9Gt pins\u001b[16Gdepend\u001b[23Gncies carefully.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6GThe contract tests alre\u001b[30Gdy\u001b[33Gcatch drift. If a\u001b[51Gfield is missing\u001b[68Gor wrong-typ\u001b[81Gd, th\u001b[87G test fails. That's \u001b[108Ghe same guarantee\u001b[126Gcodegen\r\u001b[5C\u001b[1Bgives, just enforced at test time\u001b[40Ginstead\u001b[48Gof\u001b[51Gcompile\u001b[59Gtime.\r\u001b[2C\u001b[1B4\u001b[6GIf the API grow\u001b[22G \u001b[24Gignificantly (S5 adds\u001b[46Gclaims/sess\u001b[58Gons/knowledge/c\u001b[75Gtext/"]
[0.001, "o", "\u001b[81Gven\u001b[85Gs — roughly doubling the surface), revisiting\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mopenapi-to-rust\u001b[39m at th\u001b[30Gpoint would make m\u001b[49Gre sense.\u001b[59G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImmediate cleanup:\u001b[22G\u001b[22mremove the unused \u001b[38;2;177;185;249moas3\u001b[39m dev-d\u001b[51Gpendency\u001b[60Gsince\u001b[66Gwe're\u001b[72Gnot\u001b[76Gusing\u001b[82Git.\r\u001b[2C\u001b[2BWant me to remove \u001b[38;2;177;185;249moas3\u001b[39m, or would you\u001b[40Grather adopt \u001b[38;2;177;185;249mopenapi-to-rust\u001b[39m now before the surface\u001b[92Ggrows?\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 8m 31s · done 10:17 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m❯ \u001b[38;2;255;255;255mwe should use oas3 it seems nice - and maybe openapi-to-rust ? can you give me a comparaison between that and oas3-gen (maintainer, \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255msupport, usage..)\u001b[39m                                                                                                                    \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[39m \u001b[1mExplore\u001b[22m(Compare openapi-to-rust vs oas3-gen)\u001b[K\r"]
