[0.000, "o", "────────────────┴──────────────┴──────────────────────┘\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[1mNote:\u001b[22m Only \u001b[38;2;177;185;249m/approve\u001b[24G\u001b[39mand\u001b[28G\u001b[38;2;177;185;249m/reject\u001b[36G\u001b[39mhave\u001b[41GOpenAPI path\u001b[54Gdefinitions. Block,\u001b[74Gunblock,\u001b[83Gand\u001b[87Gcancel\u001b[94Gare\u001b[98G\u001b[1mnot in the spec\u001b[114G\u001b[22m—\u001b[116Gthe\u001b[120Gstore\u001b[126Ghas\u001b[130Gthe\r\u001b[3C\u001b[1Blogic but there are no spec paths. Since we agreed to wire all 5, we'll add\u001b[80Gblock/unblock/cancel\u001b[101Gpaths\u001b[107Gto\u001b[110G\u001b[38;2;177;185;249mopenapi/shepherd.yaml\r\u001b[3C\u001b[1B\u001b[39mfollowing\u001b[14Gthe\u001b[18Gsame\u001b[23Gpattern\u001b[31Gas\u001b[34Gapprove/reject\u001b[49G(POST,\u001b[56Greturns\u001b[64GTask,\u001b[70G409\u001b[74Gon\u001b[77Ginvalid\u001b[85Gtransition).\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mhandlers/relations.rs\u001b[22m\u001b[39m\u001b[K\r\u001b[3C\u001b[1B         \u001b[14G   \u001b[18G    \u001b[23G       \u001b[31G  \u001b[34G              \u001b[49G      \u001b[56G       \u001b[64G     \u001b[70G   \u001b[74G  \u001b[77G       \u001b[85G            \u001b[30;1H\u001b[25;4H\u001b[?202"]
