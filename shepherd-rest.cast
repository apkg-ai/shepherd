[0.001, "o", "────────────────────────────────┴───────────────────────────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe honest picture\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe generated code handles \u001b[1mthe wire boundary\u001b[22m — what JSON shape goes in, what comes out, what status codes are valid, routing,\u001b[K\r\u001b[2C\u001b[1Bvalidation.\u001b[15GBut\u001b[19Gthe\u001b[23G\u001b[1mglue between the wire types and your domain store\u001b[73G\u001b[22mis\u001b[76Ghand-written.\u001b[90GThat's\u001b[97G~700\u001b[102Glines\u001b[108Gof\u001b[111Gconversion\u001b[122G+\u001b[124Gtrait\r\u001b[2C\u001b[1Bimplementation code.\r\u001b[4C\u001b[2Bis is inh\u001b[15Grent to the architecture: you have\u001b[50Ga domain crate (\u001b[38;2;177;185;249mshepherd_core\u001b[39m) with\u001b[86Gits o\u001b[92Gn \u001b[95Gypes and a spec-generated wire layer\u001b[132Gwith\r\u001b[2C\u001b[1Bdifferent types. Someone has to map between them. If the domain types\u001b[73Gwere the \u001b[3msame\u001b[23m as\u001b[90Gt\u001b[92Ge generated types,\u001b[111Gy\u001b[113Gu would\u001b[121G't\u001b[124Gneed\u001b[K\r"]
[0.000, "o", "\u001b[2C\u001b[1Bconv\u001b[8Grsions — but then\u001b[26G\u001b[38;2;177;185;249mshepherd_core\u001b[40G\u001b[39mwould\u001b[46Gdepend\u001b[53Gon\u001b[56Gthe\u001b[60Ggenerated\u001b[70Gcode,\u001b[76Gand\u001b[80Gthe\u001b[84G\"Tauri\u001b[91Ginsurance\"\u001b[102Gpattern\u001b[110G(domain\u001b[118Gcrate\u001b[124Gembeddable\r\u001b[2C\u001b[1Bwithout\u001b[11GHTTP)\u001b[17Gbreaks.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BSo to a\u001b[11Gswer directly: \u001b[1mno, it's not fully automatic\u001b[22m.\u001b[56GT\u001b[60Gspec-to-wire-typ\u001b[77Gs part is\u001b[88Gutomatic. The wire-to-domain bridging is\u001b[129Gmanual.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBrewed for 28s · done 10:54 PM\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m❯ \u001b[38;2;255;255;255mdo we have some good coverage and all features are tested?\u001b[39m                                                                           \r\u001b[2B\u001b[49m\u001b[38;2;215;119;87m✶\u001b[3GContemplating… \u001b[39m\u001b[K\r\u001b[3B\u001b[38;2;153;153;153m❯ \u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[41C\u001b[3B\u001b[38;2;153;153;153m← for agents · PR\u001b[60G\u001b]8;id=1rdvn4n;https://github.com/apkg-ai/shepherd/pull/31\u0007\u001b[38;2;255;193;7m\u001b[4m#31\u001b[24m\u001b[39m\u001b]8;;\u0007\u001b[30;1H\u001b[27;3H\u001b[?2026l"]
