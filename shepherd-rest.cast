[0.000, "o", "e\u001b[39m creates with \u001b[38;2;177;185;249mstatus: \"proposed\"\u001b[39m \u001b[90G \u001b[92G │\u001b[95G✅ Covered\r\u001b[23C\u001b[1B│ \u001b[90G \u001b[93G│\r\u001b[23C\u001b[1B┼─\u001b[90G─\u001b[93G┼\r\u001b[23C\u001b[1B│ \u001b[38;2;177;185;249mtask_create_ap\u001b[41Groved_auto_readies\u001b[39m — creates ap\u001b[73Groved, verifies \u001b[90G \u001b[92G │\u001b[95G✅ Covered\r\u001b[23C\u001b[1B│ \u001b[38;2;177;185;249msta\u001b[30Gus: \"ready\"\u001b[39m  \u001b[90G \u001b[93G│\r\u001b[23C\u001b[1B┼─\u001b[90G─\u001b[93G┼\r\u001b[23C\u001b[1B│ \u001b[38;2;177;185;249mtask_list_filters\u001b[39m — filters by \u001b[38;2;177;185;249mtype=code\u001b[39m and \u001b[38;2;177;185;249mstatus=proposed\u001b[39m \u001b[90G \u001b[92G │\u001b[95G✅ Covered\r\u001b[23C\u001b[1B┼─\u001b[90G─\u001b[93G┼\r\u001b[23C\u001b[1B│ \u001b[38;2;177;185;249map\u001b[29Grove_proposed_task\u001b[39m, \u001b[38;2;177;185;249map\u001b[52Grove_invalid_status_returns_409\u001b[39m \u001b[90G \u001b[92G │\u001b[95G✅ Covered\r\u001b[23C\u001b[1B┼─\u001b[90G─\u001b[93G┼\r\u001b[23C\u001b[1B│ ❌ \u001b[1mNot tested at the API level\u001b[22m — store tests cover it but no \u001b[90G \u001b[93G│\r\u001b[23C\u001b[1B│ integration test hits \u001b[38;2;177;185;249mPOST /reject\u001b[39m \u001b[90G \u001b[93G│\r\u001b[23C\u001b[1B┼─\u001b[90G─\u001b[93G┼"]
