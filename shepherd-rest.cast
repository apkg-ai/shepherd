[0.166, "o", "\u001b[?2026h\u001b[H\r\u001b[3C\u001b[3B   \r\u001b[3C\u001b[1B\u001b[1mHow openapi-to-rust works\r\u001b[3C\u001b[1B\u001b[22m\u001b[K\r\u001b[3C\u001b[1B1.\u001b[7GCLI\u001b[11Gtool\u001b[16G(\u001b[38;2;177;185;249mcargo install openapi-to-rust\u001b[39m)\u001b[48Greads\u001b[54Gthe\u001b[58Gspec\u001b[63G+\u001b[65Ga\u001b[67GTOML\u001b[72Gconfig\r\u001b[3C\u001b[1B2\u001b[7GGenerates into \u001b[38;2;177;185;249msrc/gen/\u001b[39m: \u001b[38;2;177;185;249mtypes.rs\u001b[39m (wire structs), \u001b[38;2;177;185;249mserver/\u001b[65G\u001b[39m(traits, response\u001b[83Genums,\u001b[90Grouter,\u001b[98Gvalidation)\r\u001b[3C\u001b[1B3\u001b[7GOne async\u001b[17Gtrait per OpenAPI tag (e.g., \u001b[38;2;177;185;249mProjectsApi\u001b[39m, \u001b[38;2;177;185;249mTasksApi\u001b[39m, \u001b[38;2;177;185;249mRelationsApi\u001b[39m)\u001b[83G\u001b[K\r\u001b[3C\u001b[1B4\u001b[11Gresponse enum per operation\u001b[46G\u001b[38;2;177;185;249mC\u001b[48GeateProjectRe\u001b[62Gponse::Cre\u001b[74Ged(Project)\u001b[39m,\u001b[87G\u001b[38;2;177;185;249m::UnprocessableEntity(ProblemDetail)\u001b[39m)\r\u001b[3C\u001b[1B5\u001b[7G\u001b[38;2;177;185;249mbuild_router(impl ProjectsApi, impl TasksApi, ...)\u001b[39m produces an axum \u001b[38;2;177;185;249mRouter\u001b[39m\u001b[K\r\u001b[3C\u001b[1B6\u001b[7GRequest validation at the HTTP boundary (JSON Schema, RFC 9457\u001b[70Gerrors) — bef"]
