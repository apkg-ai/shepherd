[0.002, "o", "\u001b[?2026h\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mReject endpoint\u001b[22m — never tested via REST. The store test (\u001b[38;2;177;185;249mreject_task_returns_to_ready\u001b[39m) covers the domain logic, but no integration\r\u001b[5C\u001b[1Btest\u001b[11Ghits\u001b[16G\u001b[38;2;177;185;249mPOST .../tasks/{id}/reject\u001b[39m.\u001b[44GTo\u001b[47Gtest\u001b[52Git\u001b[55Gproperly\u001b[64Gwe'd\u001b[69Gneed\u001b[74Ga\u001b[76Gtask\u001b[81Gin\u001b[84G\u001b[38;2;177;185;249min_review\u001b[94G\u001b[39mstatus,\u001b[102Gwhich\u001b[108Grequires\u001b[117Gclaim\u001b[123G+\u001b[125Gsession\r\u001b[2C\u001b[1B   (S5\u001b[10Gendpoints).\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mReview gate effect\u001b[25G\u001b[22m—\u001b[27Gwe\u001b[30Gtest\u001b[35Gcreating\u001b[44Ga\u001b[46Gproject\u001b[54Gwith\u001b[59G\u001b[38;2;177;185;249mreview_gate: false\u001b[78G\u001b[39min\u001b[81G\u001b[38;2;177;185;249mready_derivation_via_dependency_completion\u001b[39m,\u001b[125Gbut\u001b[129Gnever\r\u001b[2C\u001b[1B  \u001b[6Gverify that \u001b[38;2;177;185;249mreview_gate: true\u001b[39m causes a diff\u001b[50Grent task lifecycle outcome (→ \u001b[38;2;177;185;249min_review\u001b[39m instead of →\u001b[104G\u001b[38;2;177;185;249mdone\u001b[39m).\u001b[111GAga\u001b[115Gn\u001b[118Gthis requires\u001b[K\r\u001b[5C\u001b[1Bs\u001b[9Gsions (S5).\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G"]
[0.000, "o", "\u001b[1mPagination\u001b[22m — no\u001b[22Gtest\u001b[27Gexercises\u001b[37Gcursor-based\u001b[50Gpagination\u001b[61G(creating\u001b[71G26+\u001b[75Gitems\u001b[81Gand\u001b[85Gfollowing\u001b[95G\u001b[38;2;177;185;249mnext_cursor\u001b[39m).\u001b[109GThe\u001b[113Gstore\u001b[119Ghas\u001b[123Gpagination\r\u001b[2C\u001b[1B  \u001b[6Gtests, but no integration test ver\u001b[41Gfies\u001b[46Gthe wire format cursor works end-to-end.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mUpdate project settings\u001b[22m — \u001b[38;2;177;185;249mproject_crud_lifecycle\u001b[55G\u001b[39mupdates the name but never tests changing \u001b[38;2;177;185;249mreview_gat\u001b[108G\u001b[39m via PATCH.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mTask metadata\u001b[22m —\u001b[22Gno\u001b[25Gtest\u001b[30Gcreates\u001b[38Ga\u001b[40Gtask\u001b[45Gwith\u001b[50Gmetadata\u001b[59Gand\u001b[63Gverifies\u001b[72Git\u001b[75Ground-trips.\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mReques\u001b[13G validation\u001b[22m —\u001b[27Gth\u001b[30G gen\u001b[35Grated code valid\u001b[52Gtes request bod\u001b[68Ges, but no test verifies that an invalid\u001b[109Grequest body (e.\u001b[126G., m\u001b[131Gssing\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mtitle\u001b[39m on \u001b[16Gask\u001b[20Gcreate) return\u001b[35G a p\u001b[40Goper 422.\u001b[50GThe \u001b[38;2;177;185;249minvalid_uuid_returns_error\u001b[39m"]
