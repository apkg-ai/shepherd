[0.016, "o", "\u001b[?2026h\u001b[H\r\u001b[2C\u001b[1B├────────────────────────────┼───────────────────────────────────────────────────────┼───────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ oneOf/anyOf/allOf          │ Auto-discriminator detection, tagged + untagged       │ Supported, less documented                │\r\u001b[4C\u001b[1B        \u001b[14G                 \u001b[34Gf\u001b[36Gllback, well-tested                \u001b[90G         \u001b[100G   \u001b[104G        \u001b[113G      \r\u001b[4C\u001b[2BNullabl\u001b[13G (\u001b[38;2;177;185;249mtype: [X, null]\u001b[39m)\u001b[34GNative + per-fi\u001b[50Gld \u001b[38;2;177;185;249mnullable_overrides\u001b[90GOption<T>\u001b[100G\u001b[39mfor \u001b[105Gp\u001b[107Gion\u001b[111Gl fields\r\u001b[2C\u001b[1B├\u001b[32G┼\u001b[88G┼\u001b[132G┤\r\u001b[2C\u001b[1B│\u001b[5GSSE/streaming\u001b[32G│\u001b[34GTyped\u001b[40Gevents,\u001b[48Greconnection\u001b[88G│\u001b[90GBasic\u001b[96Gvia\u001b[100Gs"]
