[0.815, "o", "\u001b[?2026h\u001b[H\u001b[3G\u001b[1mWhat openapi-to-rust provides\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWire types generated from the spec\u001b[40G\u001b[22m—\u001b[42Gstructural\u001b[53Gconformance\u001b[65Gby\u001b[68Gconstruction,\u001b[82Gnot\u001b[86Gjust\u001b[91Gby\u001b[94Gtesting\r\u001b[2C\u001b[1B- \u001b[1mPer-operation response enums\u001b[22m — the compiler enforces you only return status codes the spec declares\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRequest validation at the HTTP boundary\u001b[45G\u001b[22m—\u001b[47GJSON\u001b[52GSchema validation\u001b[70Gbefore\u001b[77Gyour\u001b[82Ghandler\u001b[90Gruns,\u001b[96GRFC\u001b[100G9457 problem\u001b[113Gd\u001b[115Gtail errors\u001b[132G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mGenerated routing\u001b[22m — path/query param extraction, content-type enforcement\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat we still write by hand\u001b[32G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m\u001b[1mconvert.rs\u001b[22m\u001b[39m — \u001b[38;2;177;185;249mFrom\u001b[39m conversions between domain types (\u001b[38;2;177;185;249mshepherd_core::*\u001b[39m) and wire types (\u001b[38;2;177;185;249mgenerated::types::*\u001b[39m)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTrait implementations\u001b[22m in \u001b[38;2;177;185;249mlib.rs"]
[0.000, "o", "\u001b[39m — each method calls the store and maps\u001b[76Gresults\u001b[84Gto\u001b[87Gresponse enum variants\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m\u001b[1mmiddleware.rs\u001b[19G\u001b[22m\u001b[39m—\u001b[21GCORS\u001b[26G+\u001b[28Grate-limit headers (the generator does\u001b[67G't \u001b[71Gdd these)\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mIntegration tests\u001b[22m — behavioral tests that exercise the full stack\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerification\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G✅ \u001b[38;2;177;185;249mcargo test --workspace\u001b[31G\u001b[39m— 160 tes\u001b[41Gs pass\u001b[K\r\u001b[2C\u001b[1B- ✅ \u001b[38;2;177;185;249mcargo clippy -D warnings\u001b[39m — clean\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G✅\u001b[8G\u001b[38;2;177;185;249mcargo fmt --check\u001b[26G\u001b[39m—\u001b[28Gclean\r\u001b[2C\u001b[1B- ✅ \u001b[38;2;177;185;249mspectral lint\u001b[22G\u001b[39m—\u001b[24G0\u001b[26Gerrors,\u001b[34G0\u001b[36Gwarnings\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 17m 57s · done 10:53 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m❯ \u001b[38;2;255;255;255mok so we have the automatic generation and nothing is\u001b[57G1 new message (click) ↓ \u001b[39m                                                  "]
