[0.003, "o", "\u001b[?2026h\u001b[H\u001b[3G  \u001b[6Gpractical and the indirection of\u001b[39Ga codegen\u001b[49Gstep doesn't pay for itself yet.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GBoth viable\u001b[18Ggene\u001b[23Gators ar\u001b[32G pre-1.0 — a min\u001b[49Gr\u001b[51Gvers\u001b[56Gon\u001b[59Gbu\u001b[62Gp can\u001b[68Gchange\u001b[75Gthe\u001b[79Ggenerated\u001b[89GAPI.\u001b[94GThat's\u001b[101Ga\u001b[103Gmaintenance\u001b[115Grisk\u001b[120Gfor\u001b[124Ga\u001b[126Gproject\r\u001b[2C\u001b[1B  \u001b[6Gtha\u001b[10G pins dependencies carefully.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GThe contract tests\u001b[25Galready catch drift. If a fi\u001b[54Gld is\u001b[60Gmissing\u001b[68Gor\u001b[71Gwrong-typed,\u001b[84Gthe\u001b[88Gtest\u001b[93Gfails.\u001b[100GThat's\u001b[107Gthe\u001b[111Gsame\u001b[116Gguarantee\u001b[126Gcodegen\r\u001b[5C\u001b[1Bgives,\u001b[13Gjust\u001b[18Genforced\u001b[27Gat\u001b[30Gtest\u001b[35Gtime\u001b[40Ginstead\u001b[48Gof\u001b[51Gcompile\u001b[59Gtime.\r\u001b[2C\u001b[1B4. If the API grows significantly (S5 adds claims/session\u001b[61G/knowl\u001b[68Gdg\u001b[71G/c\u001b[74Gntext/events\u001b[87G—\u001b[89Groughly\u001b[97Gdoubling\u001b[106Gthe\u001b[110Gsurface),\u001b[120Grevisiting\r\u001b[5C\u001b[1B\u001b[38;2;177;185;249mopenapi-to-rust\u001b[22G\u001b[39mat\u001b[25Gthat\u001b[30Gpoint\u001b[36Gwould\u001b[42Gmake\u001b[47Gmore\u001b[52Gsense.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mImmediate clean"]
