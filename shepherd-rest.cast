[0.000, "o", "9m.patch()\u001b[39m is a method on \u001b[38;2;177;185;249mMethodRouter\u001b[39m, no\u001b[72G a sta\u001b[79Gdalo\u001b[84Ge fu\u001b[89Gction\u001b[95G— it's a\u001b[104Gmethod chained on\u001b[122Gthe route\u001b[K\r\u001b[2C\u001b[1Bbuilder. The \u001b[38;2;177;185;249mpatch\u001b[22G\u001b[39mimport is from \u001b[38;2;177;185;249maxum::routing\u001b[39m which\u001b[57Gprovides\u001b[66Gthe stan\u001b[75Galon\u001b[81Gfunction.\u001b[91GBut\u001b[95Ghere\u001b[100GI'm\u001b[104Gchaining\u001b[113G\u001b[38;2;177;185;249m.patch()\u001b[122G\u001b[39mon\u001b[125Ga\u001b[127G\u001b[38;2;177;185;249mget()\r\u001b[2C\u001b[1B\u001b[39mresult,\u001b[11Gwhich\u001b[17Guses\u001b[22Gthe\u001b[26Gmethod\u001b[33Gon\u001b[36G\u001b[38;2;177;185;249mMethodRouter\u001b[39m.\u001b[50GLet\u001b[54Gme\u001b[57Gcheck\u001b[63Gif\u001b[66Gaxum\u001b[71Gneeds\u001b[77Gthe\u001b[81Gimport:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ cargo check -p shepherd-server 2>&1 | grep -E \"warning|error\"\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m✽\u001b[39m \u001b[38;2;220;129;97mBuilding handlers and router…\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(10m 5s · ↓\u001b[39m \u001b[38;2;153;153;153m25.0k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[38;2;215;119;87m"]
