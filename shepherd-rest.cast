[0.016, "o", "\u001b[?2026h\u001b[H\r\u001b[2C\u001b[1B├───────────────────┼────────────────┼───────────────────────────────────────────────────────────────────────────────────────────┤\r\u001b[2C\u001b[1B│ \u001b[1moas3\u001b[22m              │ 🟡 Parser only │ Parses the spec into Rust structs — not a code generator. Useful as a building block but  │\r\u001b[4C\u001b[1B    \u001b[25G  \u001b[28G      \u001b[35G    \u001b[42Gdoe\u001b[46Gn't g\u001b[52Gnerate types on\u001b[68Gi\u001b[70Gs own\u001b[76G \u001b[78G   \u001b[82G \u001b[84G    \u001b[89G          \u001b[100G      \u001b[107G  \u001b[110G \u001b[112G        \u001b[121G     \u001b[127G   \r\u001b[2C\u001b[1B├───────────────────┼────────────────┼────────────────────────────────────────────"]
