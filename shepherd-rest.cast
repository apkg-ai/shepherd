[0.016, "o", "\u001b[?2026h\u001b[H\r\u001b[3C\u001b[3BThe contrac\u001b[16G conformance test\u001b[34G (\u001b[38;2;177;185;249mmod contract\u001b[39m) can be kept as a belt-\u001b[73Gnd-suspenders safety net, o\u001b[101G simplified since the generated\r\u001b[3C\u001b[1Btypes\u001b[10Gare\u001b[14Gstructurally\u001b[27Gguaranteed.\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[1m9. CI: add generation check\u001b[22m\u001b[K\r\u001b[3C\u001b[2BAdd a CI step that runs \u001b[38;2;177;185;249mopenapi-to-rust generate --check\u001b[61G\u001b[39mto\u001b[64Gdetect\u001b[71Gstale\u001b[77Ggenerated\u001b[87Goutput.\u001b[95GThis\u001b[100Gfails\u001b[106Gif\u001b[109Gthe\u001b[113Gspec\u001b[118Gchanged\u001b[126Gbut\u001b[130Gthe\r\u001b[3C\u001b[1Bgenerated\u001b[14Gcode\u001b[19Gwasn't\u001b[26Gregenerated.\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B---\u001b[K\r\u001b[3C\u001b[2B\u001b[1mFiles to create/modify/delete\r\u001b[3C\u001b[2B\u001b[22m┌───────────────────────────────────────────┬──────────────────────────────────────────────┐\r\u001b[3C\u001b[1B│\u001b[24GFile\u001b[48G│\u001b[69GAction\u001b[95G│\r\u001b[3C\u001b[1B├\u001b[48G┼\u001b[95G┤\r\u001b[5C\u001b[1B"]
