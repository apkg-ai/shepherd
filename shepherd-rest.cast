[0.000, "o", "\u001b[6G\u001b[1mNo runtime crate\u001b[23G\u001b[22m—\u001b[25GThe\u001b[29Ggenerated\u001b[39Gcode\u001b[44Gis\u001b[47Gself-contained.\u001b[63Goas3-gen\u001b[72Grequires\u001b[81Gadding\u001b[88G\u001b[38;2;177;185;249moas3-gen-support\u001b[105G\u001b[39mas\u001b[108Ga\u001b[110Gproduction\u001b[121Gdependency.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne thing favors oas3-gen:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExternal users\u001b[22m — 6+\u001b[25Gp\u001b[27Gople have fi\u001b[40Ged \u001b[44Geal issues f\u001b[82Gprojects.\u001b[92Gopenapi-to-rust's\u001b[110Gissues\u001b[117Gare\u001b[121Gall\u001b[125Gself-filed.\u001b[30;1H\u001b[27;3H\u001b[?2026l"]
