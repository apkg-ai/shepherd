[0.017, "o", "\u001b[?2026h\u001b[H\r\u001b[2C\u001b[1B├────────────────────────────┼───────────────────────────────────────────────────────┼───────────────────────────────────────────┤\r\u001b[4C\u001b[1BSelective\u001b[15Ggeneration\u001b[34GoperationId, me\u001b[50Ghod+path,\u001b[60Gor\u001b[63Gtag\u001b[90G\u001b[38;2;177;185;249m--only\u001b[39m/\u001b[38;2;177;185;249m--exclude\u001b[107G\u001b[39mby\u001b[110GoperationId\r\u001b[4C\u001b[2BoneOf/anyOf/allOf         \u001b[34GAu\u001b[37Go-discriminator\u001b[53Gdetection, tagged +\u001b[73Guntagged\u001b[90GSupported, less documented   \r\u001b[2C\u001b[1B│                            │ fallback, well-tested                                 │                                           │\r\u001b[2C\u001b[1B├────────────────────────────┼───────────────────"]
