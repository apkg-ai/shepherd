[0.335, "o", "\u001b[?2026h\u001b[3D\u001b[17B\r\u001b[3C\u001b[17Am\u001b[7m \r\u001b[3C\u001b[2B\u001b[27m\u001b[38;2;177;185;249m\u001b[1mm\u001b[22mcp        \u001b[33G\u001b[1mM\u001b[22ma\u001b[36Gage\u001b[40GMCP\u001b[44Gse\u001b[47Gv\u001b[49Grs\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153model                        Set the AI \u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153model for Claude Code (currently Opus 5 (1M context))\r\u001b[3C\u001b[1B\u001b[39m\u001b[1mm\u001b[6G\u001b[22m\u001b[38;2;153;153;153mmory    \u001b[33GEdit CLAUDE.\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153md files and memory settings\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153mobile                       Show QR code to download the Claude \u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153mobile app\r\u001b[3C\u001b[1B\u001b[39m\u001b[1mm\u001b[9G\u001b[22m\u001b[38;2;153;153;153mbug \u001b[33GReport a bug \u001b[47Gn the study tooling. Use when a /\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-* command, the installer, or the status line\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;153;153;153merrors or does\u001b[48Gs\u001b[50G\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153methin\u001b[57G wrong.\u001b[65G(proj\u001b[71Gct)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;1"]
[0.000, "o", "53m/\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-list                    List your active \u001b[39m\u001b[1mM\u001b[22m\u001b[38;2;153;153;153mETR tasks, numbered for /met\u001b[80G-con\u001b[85Ginue. (project)\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[1mm\u001b[9G\u001b[22m\u001b[38;2;153;153;153mhelp    \u001b[33GShow the \u001b[39m\u001b[1mM\u001b[22m\u001b[38;2;153;153;153mETR uplift task commands and how the flow works. (project)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153m/\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-temp                    T\u001b[35G\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153mp mode. 60 minutes to run any query on your selected model, billed to your compute budget.\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;153;153;153m(project)\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-idea\u001b[33GSuggest an i\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153mprovem\u001b[53Gn\u001b[55G to the study toolin\u001b[76G. U\u001b[80Ge\u001b[82Gfor feature i\u001b[97Gas or friction that makes the tooling\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;153;153;153mworse to \u001b[43Gse. (project)\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-n\u001b[11Gte \u001b[33GAdd a t\u001b[41G\u001b[3"]
[0.000, "o", "9m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153me\u001b[44Gtamped\u001b[51Gn\u001b[53Gte to the current METR task.\u001b[82G(p\u001b[85Goject)\r\u001b[3C\u001b[1B\u001b[39m\u001b[1mm\u001b[22m\u001b[38;2;153;153;153metr-start\u001b[33GStar\u001b[38G a new \u001b[39m\u001b[1mM\u001b[22m\u001b[38;2;153;153;153mETR uplift task. The assis\u001b[73Gant\u001b[77Gwalks you through the questionnaire and gets to work.\r\u001b[2C\u001b[1B\u001b[39m                              \u001b[38;2;153;153;153m(project)\u001b[39m\u001b[K\r\r\n\u001b[4C\u001b[17A\u001b[?2026l"]
