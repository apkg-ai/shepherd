[0.000, "o", "\u001b[1B- Generated\u001b[16G\u001b[38;2;177;185;249mbuild_router()\u001b[31G\u001b[39mis\u001b[34Gthe\u001b[38Gprimary\u001b[46Grouter;\u001b[54Gwe\u001b[57Gmerge\u001b[63Gin\u001b[66G/health,\u001b[75G/openapi.yaml,\u001b[90GUI\u001b[93Gfallback\u001b[102Gon\u001b[105Gtop\r\u001b[5C\u001b[1BKe\u001b[9Gp CORS\u001b[16G+ ra\u001b[21Ge-limit middleware on the outer router\r\u001b[3C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B--\u001b[K\r\u001b[3C\u001b[2B\u001b[1mHow openapi-to-rust works\u001b[22m\u001b[30;1H\u001b[25;4H\u001b[?2026l"]
[0.017, "o", "\u001b[?2026h\u001b[H\r\u001b[3C\u001b[3BS4 is committed\u001b[20Gon\u001b[23Gbranch\u001b[30G\u001b[38;2;177;185;249ms4-rest-projects-tasks-relations\u001b[63G\u001b[39m(PR\u001b[67G#31)\u001b[72Gwith\u001b[77Ghand-written\u001b[90Gresponse\u001b[99Gtypes,\u001b[106Ghandlers,\u001b[116Gand\u001b[120Gmiddleware.\r\u001b[3C\u001b[1BThe\u001b[8Gcode\u001b[13Gworks\u001b[19G—\u001b[21G29\u001b[24Gintegration\u001b[36Gtests\u001b[42G+\u001b[44G9\u001b[46Gcontract\u001b[55Gconformance\u001b[67Gtests\u001b[73Gall\u001b[77Gpass.\r\u001b[3C\u001b[1B\u001b[K\r\u001b[7C\u001b[1Buser\u001b[14Gant\u001b[19Gto replace the hand-written wire types and handler scaffolding with\u001b[87Gcode\u001b[92Ggenerated\u001b[102Gby\u001b[105G\u001b[38;2;177;185;249mopenapi-to-rust\u001b[39m,\u001b[122Gwhich\r\u001b[3C\u001b[1Bproduces\u001b[13Gspec-guaranteed\u001b[29Gtypes\u001b[35Gand\u001b[39Gaxum\u001b[44G0.8\u001b[48Gserver\u001b[55Gtraits\u001b[62Gfrom\u001b[67Gthe\u001b[71GOpenAPI\u001b[79G3.1\u001b[83Gspec.\u001b[89GThis\u001b[94Ggives\u001b[100Gstructural\u001b[111Gconformance\u001b[123Gby\r\u001b[3C\u001b[1Bconstructio\u001b[16G ra\u001b[20Ghe\u001b[23G th\u001b[27Gn by testing.\u001b[K\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[1mDecisions:\u001b[22m\u001b[K\r\u001b[3C\u001b[1B-\u001b[6GAmend\u001b[12Gthe\u001b[16Gexisting\u001b[25GS4\u001b[28GPR\u001b[31G(same\u001b[37Gbranch,\u001b[45Gforce-push)\r\u001b[3C\u001b[1B- Generated\u001b[16G\u001b[38;2;177;185;249mbuild_router()\u001b[31G\u001b[39mi"]
[0.000, "o", "s\u001b[34Gthe\u001b[38Gprimary\u001b[46Grouter;\u001b[54Gwe\u001b[57Gmerge\u001b[63Gin\u001b[66G/health,\u001b[75G/openapi.yaml,\u001b[90GUI\u001b[93Gfallback\u001b[102Gon\u001b[105Gtop\r\u001b[5C\u001b[1BKe\u001b[9Gp CORS\u001b[16G+ ra\u001b[21Ge-limit middleware on the outer router\r\u001b[3C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B--\u001b[K\r\u001b[3C\u001b[2B\u001b[1mHow openapi-to-rust works\r\u001b[3C\u001b[2B\u001b[22m1. CLI tool (\u001b[38;2;177;185;249mcargo install openapi-to-rust\u001b[39m)\u001b[48Greads\u001b[54Gthe\u001b[58Gspec\u001b[63G+\u001b[65Ga\u001b[67GTOML\u001b[72Gconfig\r\u001b[3C\u001b[1B2.\u001b[7GGenerates\u001b[17Ginto\u001b[22G\u001b[38;2;177;185;249msrc/gen/\u001b[39m:\u001b[32G\u001b[38;2;177;185;249mtypes.rs\u001b[41G\u001b[39m(wire\u001b[47Gstructs),\u001b[57G\u001b[38;2;177;185;249mserver/\u001b[65G\u001b[39m(traits,\u001b[74Gresponse\u001b[83Genums,\u001b[90Grouter,\u001b[98Gvalidation)\u001b[30;1H\u001b[25;4H\u001b[?2026l"]
[0.016, "o", "\u001b[?2026h\u001b[H\r\u001b[3C\u001b[3BThe user wan\u001b[17Gs t\u001b[21G repla\u001b[28Ge\u001b[30Gthe hand-written wire types and handler scaffoldi\u001b[80Gg \u001b[83Gith code generated by \u001b[38;2;177;185;249mopenapi-to-rust\u001b[39m, which    \r\u001b[3C\u001b[1Bproduces\u001b[13Gspec-guaranteed types and axum\u001b[44G0.8 se\u001b[51Gver\u001b[55Gtraits from\u001b[68Ghe OpenAPI 3.1\u001b[83Gspec.\u001b[89GThis\u001b[94Ggives\u001b[100Gstructural\u001b[111Gconformance\u001b[123Gby\r\u001b[3C\u001b[1Bconstruction\u001b[17Grather\u001b[24Gthan\u001b[29Gby\u001b[32Gtesting.\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[1mDecisions:\u001b[22m\u001b[K\r\u001b[3C\u001b[1B- Amend \u001b[13Ghe existing S4 PR (same branch,\u001b[45Gforce-push)\r\u001b[3C\u001b[1B-\u001b[6GGenerated\u001b[16G\u001b[38;2;177;185;249mbuild_router()\u001b[31G\u001b[39mis\u001b[34Gthe\u001b[38Gprimary\u001b[46Grouter;\u001b[54Gwe\u001b[57Gmerge\u001b[63Gin\u001b[66G/health,\u001b[75G/openapi.yaml,\u001b[90GUI\u001b[93Gfallback\u001b[102Gon\u001b[105Gtop\r\u001b[3C\u001b[1B- Keep CORS\u001b[16G+\u001b[18Grate-limit\u001b[29Gmiddleware\u001b[40Gon\u001b[43Gthe\u001b[47Gouter\u001b[53Grouter\r\u001b[3C\u001b[1B\u001b[K\r\u001b[4C\u001b[1B--\u001b[K\r\u001b[3C\u001b[1B\u001b[K\r\u001b[3C\u001b[1B\u001b[1mHow openapi-to-rust works\r\u001b[3C\u001b[1B\u001b[22m\u001b[K\r\u001b[3C\u001b[1B1.\u001b[7GCLI\u001b[11Gtool\u001b[16G(\u001b[38;2;177;185;249mcargo install openapi-to-rust\u001b[39m)\u001b[48Greads"]
[0.000, "o", "\u001b[54Gthe\u001b[58Gspec\u001b[63G+\u001b[65Ga\u001b[67GTOML\u001b[72Gconfig\r\u001b[3C\u001b[1B2. Generates into \u001b[38;2;177;185;249msrc/gen/\u001b[39m:\u001b[32G\u001b[38;2;177;185;249mtypes.rs\u001b[41G\u001b[39m(wire\u001b[47Gstructs),\u001b[57G\u001b[38;2;177;185;249mserver/\u001b[65G\u001b[39m(traits,\u001b[74Gresponse\u001b[83Genums,\u001b[90Grouter,\u001b[98Gvalidation)\r\u001b[3C\u001b[1B3.\u001b[7GOne\u001b[11Gasync\u001b[17Gtrait\u001b[23Gper\u001b[27GOpenAPI\u001b[35Gtag\u001b[39G(e.g.,\u001b[46G\u001b[38;2;177;185;249mProjectsApi\u001b[39m,\u001b[59G\u001b[38;2;177;185;249mTasksApi\u001b[39m,\u001b[69G\u001b[38;2;177;185;249mRelationsApi\u001b[39m)\r\u001b[3C\u001b[1B4\u001b[7GOne\u001b[11Gresponse enum per operation (e.g., \u001b[38;2;177;185;249mCreateProjectResponse::Created(Project)\u001b[39m,\u001b[87G\u001b[38;2;177;185;249m::UnprocessableEntity(ProblemDetail)\u001b[39m)\r\u001b[3C\u001b[1B5\u001b[7G\u001b[38;2;177;185;249mbuild_router(impl ProjectsA\u001b[35Gi, impl TasksApi, ...)\u001b[39m produces an axum \u001b[38;2;177;185;249mRouter\u001b[39m \u001b[83G      \u001b[90G       \u001b[98G           \u001b[30;1H\u001b[25;4H\u001b[?2026l"]
