[0.000, "o", "8Gfixed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe honest tradeoff\u001b[22m\u001b[K\r\u001b[2C\u001b[2BBoth are pre-1.0, both\u001b[26Gtarget\u001b[33Gaxum\u001b[38G0.8,\u001b[43Gboth\u001b[48Gsupport\u001b[56GOpenAPI\u001b[64G3.1.\u001b[69GThe\u001b[73Ggenerated\u001b[83Gcode\u001b[88Gfrom\u001b[93Geither\u001b[100Gtool\u001b[105Gwon't\u001b[111Greplace\u001b[119G\u001b[38;2;177;185;249mshepherd-core\u001b[133G\u001b[39m—\r\u001b[2C\u001b[1Byou'd\u001b[9Gstill\u001b[15Ghave\u001b[20Gthe\u001b[24Gdomain\u001b[31Gcrate\u001b[37Gwith\u001b[42Gits\u001b[46Gstore/lifecycle/DAG\u001b[66Glogic.\u001b[73GThe\u001b[77Ggenerated\u001b[87Gtypes\u001b[93Gwould\u001b[99Gbe\u001b[102G\u001b[1mwire types only\u001b[118G\u001b[22m(request/response\r\u001b[2C\u001b[1Bserialization), and you'd write \u001b[38;2;177;185;249mFrom<CoreType> for WireType\u001b[39m conversions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[30;1H\u001b[27;3H\u001b[?2026l"]
[0.702, "o", "\u001b[?2026h\u001b[H\u001b[3G\u001b[1mThe \u001b[38;2;177;185;249moas3\u001b[39m crate relationship is the key insight.\u001b[51G\u001b[22mIf\u001b[54Gyou\u001b[58Guse\u001b[62Gopenapi-to-rust,\u001b[79Gyou\u001b[83Gdon't\u001b[89Gneed\u001b[94G\u001b[38;2;177;185;249moas3\u001b[99G\u001b[39mat\u001b[102Gall\u001b[106G—\u001b[108Git\u001b[111Ghas\u001b[115Gits\u001b[119Gown\u001b[123Gparser.\u001b[131GIf\r\u001b[2C\u001b[1Byou use oas3-gen, \u001b[38;2;177;185;249moas3\u001b[39m comes as a transitive dependency. So the choice be\u001b[77Gween to\u001b[85Gls det\u001b[92Grmines\u001b[99Gwhether \u001b[38;2;177;185;249moas3\u001b[39m i\u001b[116Gn the picture\u001b[131G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThree things favor openapi-to-rust for this project:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;177;185;249m\u001b[1m[type_mappings]\u001b[22G\u001b[22m\u001b[39m—\u001b[24GYou\u001b[28Gcan\u001b[32Gmap\u001b[36G\u001b[38;2;177;185;249m\"DateTime\" = \"chrono::DateTime<chrono::Utc>\"\u001b[81G\u001b[39mand\u001b[85Gpotentially\u001b[97Gmap\u001b[101Gsome\u001b[106Gschemas\u001b[114Gto\u001b[117G\u001b[38;2;177;185;249mshepherd_core\u001b[131G\u001b[39mtypes\r\u001b[2C\u001b[1B  \u001b[6Gdirectly. oas3-gen has \u001b[32Gopen issue (#78) for this but no implementation.\u001b[81G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mRFC 9457 request validation built-in"]
[0.000, "o", "\u001b[43G\u001b[22m— openapi-\u001b[54Go-rust validates request bodies\u001b[86Gagainst\u001b[94Gthe\u001b[98GJSON\u001b[103GSchema\u001b[110G\u001b[3mbefore\u001b[117G\u001b[23myour\u001b[122Ghandler\u001b[130Gruns,\r\u001b[2C\u001b[1B  \u001b[6Gand returns \u001b[38;2;177;185;249mapplication/problem+json\u001b[43G\u001b[39merrors. That's exact\u001b[64Gy what\u001b[71Gshepherd's spec requires. With oas3-gen, we'd\u001b[117Gkeep\u001b[122Gour\u001b[K\r\u001b[5C\u001b[1Bhand-written \u001b[38;2;177;185;249mA\u001b[21GpError\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mNo runtime crate\u001b[22m — The\u001b[29Ggenerated\u001b[39Gcode\u001b[44Gis\u001b[47Gself-contained.\u001b[63Goas3-gen\u001b[72Grequires\u001b[81Gadding\u001b[88G\u001b[38;2;177;185;249moas3-gen-support\u001b[105G\u001b[39mas\u001b[108Ga\u001b[110Gproduction\u001b[121Gdependency.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne thing favors oas3-gen:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mExternal users\u001b[20G\u001b[22m—\u001b[22G6+\u001b[25Gpeople\u001b[32Ghave\u001b[37Gfiled\u001b[43Greal\u001b[48Gissues\u001b[55Gfrom\u001b[60Gusing\u001b[66Git\u001b[69Gin\u001b[72Gtheir\u001b[78Gown\u001b[82Gprojects.\u001b[92Gopenapi-to-rust's\u001b[110Gissues\u001b[117Gare\u001b[121Gall\u001b[125Gself-filed.\r\u001b[2C\u001b[1B \u001b[5GMore external users\u001b[25Gm\u001b[27Gans more rea\u001b[40G-wo\u001b[44Gld edge cases fo\u001b[61Gnd "]
